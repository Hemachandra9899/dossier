// Dossier signing domain.
//
// Provider-agnostic models that mirror the Documenso signing engine into
// Dossier-owned state. Signing is OPTIONAL: a Document may have zero
// SignatureRequest rows (STORE/SHARE-only documents never touch these tables).
//
// Dossier owns: signature request metadata, recipients, final signed files and
// the provider-event inbox. Documenso owns: envelope execution, PDF signing and
// temporary signing data. We never query the Documenso database from here.

enum SignatureProvider {
  DOCUMENSO
}

enum SignatureTemplateStatus {
  PREPARING
  READY
  FAILED
  ARCHIVED
}

enum SignatureRequestStatus {
  DRAFT
  PREPARING
  READY
  SENT
  VIEWED
  SIGNING
  PARTIALLY_SIGNED
  COMPLETED
  DECLINED
  EXPIRED
  CANCELLED
  FAILED
}

enum SignatureRecipientStatus {
  PENDING
  VIEWED
  SIGNING
  SIGNED
  DECLINED
  EXPIRED
}

model SignatureTemplate {
  id                 String                  @id @default(cuid())
  teamId             String
  documentId         String
  name               String
  provider           SignatureProvider       @default(DOCUMENSO)
  providerExternalId String                  @unique
  providerTemplateId String?
  providerEnvelopeId String?
  status             SignatureTemplateStatus @default(PREPARING)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  team     Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  document Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  requests SignatureRequest[]

  @@unique([provider, providerEnvelopeId])
  @@index([teamId, createdAt(sort: Desc)])
  @@index([documentId])
}

model SignatureRequest {
  id         String  @id @default(cuid())
  teamId     String
  documentId String
  // The envelope flow (SIGN.2) creates one DOCUMENT envelope per request and
  // owns no template row; the legacy template flow still sets this.
  templateId String?
  linkId     String?

  provider           SignatureProvider @default(DOCUMENSO)
  providerExternalId String            @unique
  providerEnvelopeId String?
  providerDocumentId Int?

  status SignatureRequestStatus @default(DRAFT)

  sentAt      DateTime?
  viewedAt    DateTime?
  completedAt DateTime?
  cancelledAt DateTime?
  expiresAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dossierFileId String?

  team        Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  document    Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  template    SignatureTemplate? @relation(fields: [templateId], references: [id], onDelete: Restrict)
  link        Link?             @relation(fields: [linkId], references: [id], onDelete: SetNull)
  dossierFile DossierFile?      @relation(fields: [dossierFileId], references: [id], onDelete: SetNull)

  recipients SignatureRecipient[]
  artifact   SignatureArtifact?
  deliveries SignatureDelivery[]
  activities SignatureActivity[]

  @@unique([provider, providerEnvelopeId])
  @@index([teamId, status, createdAt(sort: Desc)])
  @@index([documentId, createdAt(sort: Desc)])
  @@index([linkId])
  @@index([dossierFileId])
}

model SignatureRecipient {
  id                  String                   @id @default(cuid())
  signatureRequestId  String
  name                String?
  email               String?
  phone               String?
  signingOrder        Int                      @default(1)
  providerRecipientId String?
  providerDocumentId  Int?
  status              SignatureRecipientStatus @default(PENDING)
  viewedAt            DateTime?
  signedAt            DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  signatureRequest SignatureRequest    @relation(fields: [signatureRequestId], references: [id], onDelete: Cascade)
  deliveries       SignatureDelivery[]
  activities       SignatureActivity[]

  @@index([signatureRequestId, status])
  @@index([email])
}

// Final signed artifact mirrored into Dossier-owned storage. IMMUTABLE: never
// update a row once written; corrections produce a new SignatureRequest.
model SignatureArtifact {
  id                 String   @id @default(cuid())
  signatureRequestId String   @unique
  storageKey         String
  fileName           String
  mimeType           String   @default("application/pdf")
  sha256             String
  sizeBytes          BigInt
  createdAt          DateTime @default(now())

  signatureRequest SignatureRequest @relation(fields: [signatureRequestId], references: [id], onDelete: Cascade)
}

// Idempotent provider-event inbox: webhook deliveries are upserted on
// `dedupeKey` before any business processing happens.
model SigningProviderEvent {
  id                 String            @id @default(cuid())
  provider           SignatureProvider
  dedupeKey          String            @unique
  eventType          String
  externalId         String?
  providerDocumentId Int?
  payload            Json
  processedAt        DateTime?
  failedAt           DateTime?
  errorCode          String?
  createdAt          DateTime          @default(now())

  @@index([provider, createdAt(sort: Desc)])
  @@index([processedAt])
}

enum SignatureDeliveryType {
  INVITATION
  REMINDER
  COMPLETION
}

enum SignatureDeliveryStatus {
  PENDING
  SENT
  FAILED
}

model SignatureDelivery {
  id                 String                  @id @default(cuid())
  signatureRequestId String
  recipientId        String?
  type               SignatureDeliveryType
  status             SignatureDeliveryStatus @default(PENDING)
  retryCount         Int                     @default(0)
  lastAttemptAt      DateTime?
  failedReason       String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  signatureRequest SignatureRequest    @relation(fields: [signatureRequestId], references: [id], onDelete: Cascade)
  recipient        SignatureRecipient? @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([signatureRequestId, status])
  @@index([recipientId])
}

enum SignatureActivityType {
  REQUEST_CREATED
  INVITATION_SENT
  INVITATION_FAILED
  RECIPIENT_VIEWED
  SIGNING_STARTED
  REMINDER_SENT
  REQUEST_CANCELLED
  RECIPIENT_SIGNED
  REQUEST_COMPLETED
  ARTIFACT_READY
}

model SignatureActivity {
  id                 String                @id @default(cuid())
  signatureRequestId String
  recipientId        String?
  type               SignatureActivityType
  timestamp          DateTime              @default(now())
  metadata           Json?

  signatureRequest SignatureRequest    @relation(fields: [signatureRequestId], references: [id], onDelete: Cascade)
  recipient        SignatureRecipient? @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([signatureRequestId, timestamp(sort: Desc)])
  @@index([recipientId])
}
